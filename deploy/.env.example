# NexusEdge Single-PoP Deployment Configuration
# In production / staging, bind directly to standard public ingress ports (80 and 443)
ENVOY_HTTP_PORT=80
ENVOY_HTTPS_PORT=443

# For non-root local development if port 80/443 are in use, uncomment:
# ENVOY_HTTP_PORT=10000
# ENVOY_HTTPS_PORT=10443

# Automated Instant Alerting (Telegram Bot)
# NEXUSEDGE_ALERT_TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ
# NEXUSEDGE_ALERT_TELEGRAM_CHAT_ID=987654321
# NEXUSEDGE_ALERT_LATENCY_THRESHOLD_MS=1000
# NEXUSEDGE_ALERT_COOLDOWN_SECONDS=300
